NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/printhub?retryWrites=true&w=majority&appName=printhub

JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_SESSION_SECRET=your_jwt_session_secret_key_here

STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads
RATE_LIMIT_MAX=1000
