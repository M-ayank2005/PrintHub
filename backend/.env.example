NODE_ENV=production
PORT=4000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/printhub?retryWrites=true&w=majority&appName=printhub

# JWT secrets (must be at least 32 characters in production)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_token_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_min_32_chars
JWT_SESSION_SECRET=your_super_secret_jwt_session_token_key_min_32_chars

# CORS allowed origins (comma-separated, no wildcard in production)
CORS_ORIGINS=https://print.yourdomain.com,http://tauri.localhost

# Public URLs
PUBLIC_API_URL=https://api.yourdomain.com
CUSTOMER_APP_URL=https://print.yourdomain.com

# Storage driver ('s3' in production, 'local' dev only)
STORAGE_DRIVER=s3
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_BUCKET=printhub-temp
S3_ACCESS_KEY_ID=your_s3_key_id
S3_SECRET_ACCESS_KEY=your_s3_application_key
